# ===================================================================
# Smart Financial Expense Analysis - Environment Configuration Template
# 
# Copy this file to '.env' if you want a local configuration reference,
# or export these environment variables in your terminal / system.
# DO NOT commit the actual '.env' file or real credentials to Git!
# ===================================================================

# Application Server Port (Change if 8080 is already occupied)
SERVER_PORT=8080

# MySQL Database Host
DB_HOST=localhost

# MySQL Database Port (Default is 3306)
DB_PORT=3306

# MySQL Database Name
DB_NAME=smart_financial_expense

# MySQL Username
DB_USERNAME=root

# MySQL Password (leave blank if no password is set)
DB_PASSWORD=

# Initial Administrator Credentials (Optional)
# If provided, an initial admin account is created upon application startup if no admin exists
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
