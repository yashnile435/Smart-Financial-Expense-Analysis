# ===================================================================
# Smart Financial Expense Analysis - Git Ignore Rules
# ===================================================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Compiled Java class files
*.class

# Package files
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build output
target/
!**/src/main/**/target/
!**/src/test/**/target/

# Keep Maven Wrapper JAR
!.mvn/wrapper/maven-wrapper.jar

# Log files and directories
*.log
logs/
*.log.*

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-userId

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Visual Studio Code
.vscode/

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Crash logs & temporary files
*.swp
*~
*.bak
